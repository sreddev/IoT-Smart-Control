<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (default). Keys are referenced via DynamicResource so the theme can swap at runtime. -->
    <Color x:Key="AccentColor">#FF7A1A</Color>
    <SolidColorBrush x:Key="Accent" Color="#FF7A1A" />
    <SolidColorBrush x:Key="AccentSoft" Color="#3A2A18" />
    <SolidColorBrush x:Key="WindowBg" Color="#121419" />
    <SolidColorBrush x:Key="CardBg" Color="#1C2027" />
    <SolidColorBrush x:Key="SidebarBg" Color="#0E1013" />
    <SolidColorBrush x:Key="SidebarFg" Color="#C9CED6" />
    <SolidColorBrush x:Key="Border" Color="#2B303A" />
    <SolidColorBrush x:Key="TextMain" Color="#E8EBF0" />
    <SolidColorBrush x:Key="TextMuted" Color="#949CA8" />
    <SolidColorBrush x:Key="Ok" Color="#37C27A" />
    <SolidColorBrush x:Key="Bad" Color="#E5635F" />
    <SolidColorBrush x:Key="ControlBg" Color="#272C35" />
    <SolidColorBrush x:Key="InputBg" Color="#23272F" />
    <SolidColorBrush x:Key="ListHover" Color="#3A414D" />
    <SolidColorBrush x:Key="DimLow" Color="#2B2B2B" />
</ResourceDictionary>
