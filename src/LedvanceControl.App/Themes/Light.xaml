<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Same keys as Dark.xaml. -->
    <Color x:Key="AccentColor">#FF6A00</Color>
    <SolidColorBrush x:Key="Accent" Color="#FF6A00" />
    <SolidColorBrush x:Key="AccentSoft" Color="#FFF0E5" />
    <SolidColorBrush x:Key="WindowBg" Color="#F4F5F7" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBg" Color="#1F2329" />
    <SolidColorBrush x:Key="SidebarFg" Color="#C9CED6" />
    <SolidColorBrush x:Key="Border" Color="#E2E5EA" />
    <SolidColorBrush x:Key="TextMain" Color="#1F2329" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B7380" />
    <SolidColorBrush x:Key="Ok" Color="#1E9E5A" />
    <SolidColorBrush x:Key="Bad" Color="#C83A3A" />
    <SolidColorBrush x:Key="ControlBg" Color="#EEF0F3" />
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListHover" Color="#C0C6CF" />
    <SolidColorBrush x:Key="DimLow" Color="#3A3A3A" />
</ResourceDictionary>
