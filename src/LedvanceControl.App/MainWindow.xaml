<Window x:Class="LedvanceControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LedvanceControl.App.Views"
        Title="LEDVANCE Smart+ WiFi Control" Height="820" Width="1280" MinWidth="980" MinHeight="600"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.RowSpan="2" Background="{StaticResource SidebarBg}">
            <StackPanel DockPanel.Dock="Top" Margin="22,24,10,26">
                <TextBlock Text="LEDVANCE" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="20" />
                <TextBlock Text="Smart+ WiFi for Windows" Foreground="{StaticResource SidebarFg}" FontSize="12" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
                <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Devices"
                             IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConv}, ConverterParameter=Devices}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA80;" FontFamily="{StaticResource Icons}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0" />
                        <TextBlock Text="Devices" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Groups"
                             IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConv}, ConverterParameter=Groups}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Icons}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0" />
                        <TextBlock Text="Groups" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Scenes"
                             IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConv}, ConverterParameter=Scenes}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0" />
                        <TextBlock Text="Scenes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Schedules"
                             IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConv}, ConverterParameter=Schedules}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0" />
                        <TextBlock Text="Schedules" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                             IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsConv}, ConverterParameter=Settings}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,12,0" />
                        <TextBlock Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Unofficial client · Tuya LAN + OpenAPI" Foreground="#6B7380" FontSize="11"
                       Margin="22,0,10,16" VerticalAlignment="Bottom" TextWrapping="Wrap" />
            <Grid />
        </DockPanel>

        <!-- Pages -->
        <Grid Grid.Column="1" Margin="24,20,24,8">
            <views:DevicesView Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=Devices}" />
            <views:GroupsView DataContext="{Binding Groups}"
                              Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=Groups}" />
            <views:ScenesView DataContext="{Binding Scenes}"
                              Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=Scenes}" />
            <views:SchedulesView DataContext="{Binding Schedules}"
                                 Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=Schedules}" />
            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter=Settings}" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,6" Background="{StaticResource CardBg}">
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Bad}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
