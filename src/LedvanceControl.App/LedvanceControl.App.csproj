<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LedvanceControl.Core\LedvanceControl.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>IoTSmartControl</AssemblyName>
    <RootNamespace>LedvanceControl.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>IoT Smart Control for Windows</Product>
    <AssemblyTitle>IoT Smart Control for Windows</AssemblyTitle>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its types out of the global namespace -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>

