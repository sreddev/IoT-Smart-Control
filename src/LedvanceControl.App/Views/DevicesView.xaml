<UserControl x:Class="LedvanceControl.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LedvanceControl.App.Views">
    <!-- DataContext: MainViewModel -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,16,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Devices" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="All off" Command="{Binding AllOffCommand}" />
                    <Button Content="Refresh" Command="{Binding RefreshAllCommand}" Margin="0" />
                </StackPanel>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10"
                       Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}"
                       Text="No devices yet. Go to Settings to synchronise from the Tuya cloud, import a devices.json file or add a device manually." />
            <ListBox ItemsSource="{Binding DevicesView}" SelectedItem="{Binding SelectedDevice}"
                     ItemContainerStyle="{StaticResource CardListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="2,10,0,6" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IsOn}" VerticalAlignment="Center"
                                      Visibility="{Binding HasPower, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedDevice}">
            <StackPanel Visibility="{Binding Converter={StaticResource NullToVis}}">
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Margin="0" />
                    <Button DockPanel.Dock="Right" Content="Diagnostics" Command="{Binding DiagnosticsCommand}" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" Margin="0" />
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="{Binding Subtitle, Mode=OneWay}" /> · <Run Text="{Binding Room, Mode=OneWay}" /> · <Run Text="{Binding StatusText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource Card}" Visibility="{Binding IsLight, Converter={StaticResource BoolToVis}}">
                    <views:LightPanel DataContext="{Binding Light}" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Data points" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                   Text="Every function the device exposes (the Android app renders these as the device panel)." />
                        <ItemsControl ItemsSource="{Binding Dps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Schema.Code}" />
                                        <Grid Grid.Column="1" Margin="8,0">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" HorizontalAlignment="Left"
                                                      Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />
                                            <Slider Minimum="0" Maximum="1000" Value="{Binding SliderPosition}" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                    Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}" />
                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding EnumValue}" HorizontalAlignment="Left" MinWidth="160"
                                                      Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}" />
                                            <DockPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendTextCommand}" Margin="6,0,0,0" />
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                            </DockPanel>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Display}" MinWidth="80" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


