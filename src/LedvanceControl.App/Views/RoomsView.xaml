<UserControl x:Class="LedvanceControl.App.Views.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LedvanceControl.App.Views">
    <!-- DataContext: RoomsViewModel -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,6,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rooms" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
                    <views:HelpButton Topic="Rooms" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="+ New room" Style="{StaticResource AccentButton}" Command="{Binding AddCommand}" HorizontalAlignment="Right" Margin="0" />
            </DockPanel>

            <!-- Selected house (switch houses in the sidebar) -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="House" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding HouseName, UpdateSourceTrigger=LostFocus}" FontSize="15" ToolTip="Rename the selected house" />
                    <TextBlock Text="{Binding HouseSourceHint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ New house" Command="{Binding AddHouseCommand}" Margin="0,0,8,0" />
                        <Button Content="Delete house" Command="{Binding DeleteHouseCommand}" IsEnabled="{Binding CanDeleteHouse}"
                                ToolTip="{Binding DeleteHouseTip}" ToolTipService.ShowOnDisabled="True" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="{Binding UnassignedSummary}" Style="{StaticResource Muted}" Margin="2,0,0,10" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource CardListItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ToolTip="Drag to resize" />

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
            <StackPanel Visibility="{Binding Converter={StaticResource NullToVis}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Delete room" Margin="8,0,0,0"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=LostFocus}" FontSize="15" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="All on" Style="{StaticResource AccentButton}" Command="{Binding OnCommand}" />
                            <Button Content="All off" Command="{Binding OffCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <views:LightPanel DataContext="{Binding Light}" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Devices in this room" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="A device belongs to one room: ticking it moves it here from its current room; unticking leaves it without a room." />
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsMember}" Width="260" ToolTip="{Binding OtherRoom}">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Device.Name, Mode=OneWay}" /><Run Text="{Binding OtherRoomSuffix, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
