<UserControl x:Class="LedvanceControl.App.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LedvanceControl.App.Views">
    <!-- DataContext: GroupsViewModel -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,16,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Groups" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
                <Button Content="+ New group" Style="{StaticResource AccentButton}" Command="{Binding AddCommand}" HorizontalAlignment="Right" Margin="0" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10"
                       Text="Groups let you switch and dim several lights at once, like the Groups tab of the mobile app." />
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource CardListItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MemberSummary}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}">
            <StackPanel Visibility="{Binding Converter={StaticResource NullToVis}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Delete group" Margin="8,0,0,0"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontSize="15" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="All on" Style="{StaticResource AccentButton}" Command="{Binding OnCommand}" />
                            <Button Content="All off" Command="{Binding OffCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <views:LightPanel DataContext="{Binding Light}" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Members" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsMember}" Content="{Binding Device.Name}" Width="220" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
