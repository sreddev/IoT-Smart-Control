<Window x:Class="LedvanceControl.App.Views.ExportBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export settings" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextMain}" FontFamily="Segoe UI" FontSize="13">
  <!-- Export: choose what goes into the backup; keys and credentials require a password (they are encrypted with it). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,16">
            <DockPanel Margin="0,0,0,16">
                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Export settings" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Saves your setup to one file you can keep or open on another PC." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="INCLUDE" Style="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
            <CheckBox x:Name="DevicesBox" IsChecked="True" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Houses, rooms &amp; devices" />
                    <TextBlock x:Name="DevicesCount" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="AutomationsBox" IsChecked="True" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Groups, scenes &amp; schedules" />
                    <TextBlock x:Name="AutomationsCount" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="PreferencesBox" IsChecked="True" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="App preferences &amp; cloud accounts" />
                    <TextBlock Text="Theme, start-up options, Tuya and SmartThings app ids" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="SecretsBox" IsChecked="True" Checked="SecretsBox_Changed" Unchecked="SecretsBox_Changed">
                <StackPanel>
                    <TextBlock Text="Keys &amp; credentials (encrypted)" />
                    <TextBlock Text="Local keys, client secrets and the SmartThings sign-in" Style="{StaticResource Muted}" FontSize="11" />
                </StackPanel>
            </CheckBox>

            <StackPanel x:Name="PasswordPanel" Margin="0,14,0,0">
                <TextBlock Text="Backup password" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                <PasswordBox x:Name="Password1" PasswordChanged="Password_Changed" AutomationProperties.Name="Backup password" />
                <TextBlock Text="Repeat password" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,3" />
                <PasswordBox x:Name="Password2" PasswordChanged="Password_Changed" AutomationProperties.Name="Repeat password" />
                <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="9,7" Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMain}">
                        The keys are encrypted with this password (AES-256). Without it the backup can't be imported, and it can't be recovered, so keep it somewhere safe.
                    </TextBlock>
                </Border>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
                <Button x:Name="ExportButton" Content="Export…" Style="{StaticResource AccentButton}" IsDefault="True" Padding="16,6" Click="Export_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
