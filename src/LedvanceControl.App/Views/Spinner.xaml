<UserControl x:Class="LedvanceControl.App.Views.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="14" Height="14" Foreground="{DynamicResource Accent}" IsHitTestVisible="False" Focusable="False">
    <!-- A loading circle: a faint ring with a rotating quarter arc, in the Foreground colour. -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="Rotation" />
        </Grid.RenderTransform>
        <Ellipse x:Name="Track" StrokeThickness="2" Opacity="0.25"
                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Ellipse x:Name="Arc" StrokeThickness="2" StrokeDashCap="Round"
                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </Grid>
</UserControl>
