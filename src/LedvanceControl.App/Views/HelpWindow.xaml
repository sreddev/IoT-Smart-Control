<Window x:Class="LedvanceControl.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help" Width="640" MaxHeight="780" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,22,24,12">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Accent}" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="?" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap" />
                        <TextBlock x:Name="IntroText" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl x:Name="StepsList" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="23" Height="23" CornerRadius="11.5" Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.3" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding No}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextMain}" Margin="9,1,0,0" LineHeight="20" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="TipBox" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="13,11" Margin="0,4,0,2">
                    <TextBlock x:Name="TipText" TextWrapping="Wrap" Foreground="{DynamicResource TextMain}" LineHeight="20" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" MinWidth="90" IsDefault="True" IsCancel="True" />
        </Border>
    </Grid>
</Window>
