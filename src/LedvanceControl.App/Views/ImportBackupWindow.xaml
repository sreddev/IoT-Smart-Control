<Window x:Class="LedvanceControl.App.Views.ImportBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import settings" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextMain}" FontFamily="Segoe UI" FontSize="13">
  <!-- Import preview: what the file holds (readable without the password), the password if it is
         encrypted, and Merge / Replace. A safety copy of the current settings is saved before applying. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,20,24,16">
            <DockPanel Margin="0,0,0,16">
                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Import settings" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Check what's in the backup, then choose how to apply it." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock" x:Key="K" BasedOn="{StaticResource Muted}">
                            <Setter Property="Margin" Value="0,2,16,2" />
                        </Style>
                        <Style TargetType="TextBlock" x:Key="V">
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </Grid.Resources>
                    <TextBlock Text="File" Style="{StaticResource K}" />
                    <TextBlock x:Name="FileText" Grid.Column="1" Style="{StaticResource V}" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Text="Created" Style="{StaticResource K}" />
                    <TextBlock x:Name="CreatedText" Grid.Row="1" Grid.Column="1" Style="{StaticResource V}" />
                    <TextBlock Grid.Row="2" Text="Contains" Style="{StaticResource K}" />
                    <TextBlock x:Name="ContainsText" Grid.Row="2" Grid.Column="1" Style="{StaticResource V}" />
                    <TextBlock Grid.Row="3" Text="Keys" Style="{StaticResource K}" />
                    <TextBlock x:Name="KeysText" Grid.Row="3" Grid.Column="1" Style="{StaticResource V}" />
                </Grid>
            </Border>

            <StackPanel x:Name="PasswordPanel" Margin="0,14,0,0">
                <TextBlock Text="Backup password" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3" />
                <PasswordBox x:Name="Password" PasswordChanged="Password_Changed" AutomationProperties.Name="Backup password" />
            </StackPanel>

            <TextBlock Text="HOW TO APPLY" Style="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,6" />
            <UniformGrid Columns="2">
                <RadioButton x:Name="MergeChoice" Style="{StaticResource ChoiceCard}" GroupName="Mode" IsChecked="True" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Merge" FontWeight="SemiBold" />
                        <TextBlock Text="Add new items, update matching ones, keep the rest." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ReplaceChoice" Style="{StaticResource ChoiceCard}" GroupName="Mode" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Replace" FontWeight="SemiBold" />
                        <TextBlock Text="Use only what's in the file for the parts it contains." Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="9,7" Margin="0,14,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMain}">
                    Your current settings are saved first, so <Run FontWeight="SemiBold">Backup ▸ Undo last import</Run> can bring them back. The app restarts to apply the import. Matter bulbs from another PC need pairing again on this one.
                </TextBlock>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
                <Button x:Name="ImportButton" Content="Import and restart" Style="{StaticResource AccentButton}" IsDefault="True" Padding="16,6" Click="Import_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
