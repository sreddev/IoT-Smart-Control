<UserControl x:Class="LedvanceControl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LedvanceControl.App.Views"
             xmlns:vm="clr-namespace:LedvanceControl.App.ViewModels">
    <!-- DataContext: SettingsViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
                <views:HelpButton Topic="Settings" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- App settings + About: one combined card, settings on the left, About on the right (layout C) -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <Border.Resources>
                    <!-- one preference row: name + description on the left, the control right-aligned -->
                    <Style x:Key="PrefName" TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                    </Style>
                    <Style x:Key="PrefDesc" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Margin" Value="0,1,0,0" />
                    </Style>
                    <Style x:Key="PrefLine" TargetType="Border">
                        <Setter Property="Height" Value="1" />
                        <Setter Property="Background" Value="{DynamicResource Border}" />
                        <Setter Property="Margin" Value="0,10" />
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- App settings -->
                    <StackPanel Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="App settings" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                            <views:HelpButton Topic="Settings.Appearance" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.ThemeLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0" ToolTip="On = Dark, off = Light"
                                          IsChecked="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Dark theme" Style="{StaticResource PrefName}" />
                                <TextBlock Text="Dark or Light. Applied immediately." Style="{StaticResource PrefDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource PrefLine}" />

                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0"
                                      IsChecked="{Binding DataContext.StartMinimized, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Start minimized" Style="{StaticResource PrefName}" />
                                <TextBlock Text="Launches the app at Windows start-up, straight into the tray." Style="{StaticResource PrefDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource PrefLine}" />

                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0"
                                      IsChecked="{Binding DataContext.CloseToTray, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Close to tray" Style="{StaticResource PrefName}" />
                                <TextBlock Text="Closing the window keeps the app running in the tray, so schedules keep firing." Style="{StaticResource PrefDesc}" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource PrefLine}" />

                        <!-- Backup & restore (option B): one button that opens a menu -->
                        <DockPanel>
                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="BackupBtn" Command="{Binding ToggleBackupCommand}" Padding="12,5" MinWidth="104"
                                        HorizontalContentAlignment="Stretch" AutomationProperties.Name="Backup"
                                        IsHitTestVisible="{Binding IsOpen, ElementName=BackupPopup, Converter={StaticResource InverseBool}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="10,1,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Icons}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Backup" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                                <Popup x:Name="BackupPopup" IsOpen="{Binding IsBackupOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=BackupBtn}"
                                       Placement="Bottom" HorizontalOffset="-150" VerticalOffset="4" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8"
                                            Padding="6" Width="254" Margin="0,0,8,8">
                                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" /></Border.Effect>
                                        <StackPanel>
                                            <Button AutomationProperties.Name="Export settings…" Style="{StaticResource MenuRow}" Padding="10,7" Command="{Binding ExportBackupCommand}">
                                                <DockPanel>
                                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="Export settings…" FontWeight="SemiBold" />
                                                        <TextBlock Text="Save everything to a backup file" Style="{StaticResource Muted}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                            <Button AutomationProperties.Name="Import settings…" Style="{StaticResource MenuRow}" Padding="10,7" Command="{Binding ImportBackupCommand}">
                                                <DockPanel>
                                                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="Import settings…" FontWeight="SemiBold" />
                                                        <TextBlock Text="Review a backup, then merge or replace" Style="{StaticResource Muted}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                            <Border Height="1" Background="{DynamicResource Border}" Margin="4,4" />
                                            <Button AutomationProperties.Name="Undo last import" Style="{StaticResource MenuRow}" Padding="10,6" Command="{Binding UndoImportCommand}">
                                                <DockPanel>
                                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="1,0,13,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Undo last import" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                            <Button AutomationProperties.Name="Open safety copies folder" Style="{StaticResource MenuRow}" Padding="10,6" Command="{Binding OpenBackupsFolderCommand}">
                                                <DockPanel>
                                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="14" Margin="1,0,13,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Open safety copies folder" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Backup &amp; restore" Style="{StaticResource PrefName}" />
                                <TextBlock Text="Move your setup to another PC, or keep a safe copy. Keys are exported only with a password." Style="{StaticResource PrefDesc}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Border}" />

                    <!-- About -->
                    <StackPanel Grid.Column="2" Margin="24,0,0,0">
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                                <Image Source="pack://application:,,,/IoTSmartControl;component/Assets/app-icon.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="IoT Smart Control" Style="{StaticResource H2}" Margin="0" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="CREATED BY" Style="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,12" FontSize="15">
                            <Run Text="Sergio" FontWeight="SemiBold" /><Run Text=" with " Foreground="{DynamicResource TextMuted}" /><Run Text="&#x2665;" Foreground="{DynamicResource Accent}" />
                        </TextBlock>

                        <Button Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static vm:SettingsViewModel.TelegramUrl}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE724;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Telegram @sreddev" />
                            </StackPanel>
                        </Button>

                        <!-- Support: one primary button that opens a menu of ways to donate -->
                        <Grid>
                            <Button x:Name="SupportBtn" Style="{StaticResource AccentButton}" Command="{Binding ToggleSupportCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0" Padding="12,7"
                                    AutomationProperties.Name="Support development"
                                    IsHitTestVisible="{Binding IsOpen, ElementName=SupportPopup, Converter={StaticResource InverseBool}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xEB51;" FontFamily="{StaticResource Icons}" Margin="0,1,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Support development" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Popup x:Name="SupportPopup" IsOpen="{Binding IsSupportOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=SupportBtn}"
                                   Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8"
                                        Padding="6" Width="{Binding ActualWidth, ElementName=SupportBtn}" Margin="0,0,8,8">
                                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" /></Border.Effect>
                                    <StackPanel>
                                        <Button AutomationProperties.Name="Donate with PayPal" Style="{StaticResource MenuRow}" Padding="10,7" Command="{Binding OpenUrlCommand}"
                                                CommandParameter="{x:Static vm:SettingsViewModel.PayPalDonateUrl}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="Donate with PayPal" FontWeight="SemiBold" />
                                                    <TextBlock Text="PayPal balance or card" Style="{StaticResource Muted}" FontSize="11" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                        <Button AutomationProperties.Name="Donate with Revolut" Style="{StaticResource MenuRow}" Padding="10,7" Command="{Binding OpenUrlCommand}"
                                                CommandParameter="{x:Static vm:SettingsViewModel.RevolutUrl}">
                                            <DockPanel>
                                                <TextBlock Text="&#xE825;" FontFamily="{StaticResource Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="Donate with Revolut" FontWeight="SemiBold" />
                                                    <TextBlock Text="Card, Apple Pay, Google Pay or Revolut" Style="{StaticResource Muted}" FontSize="11" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Text="MIT License" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="2,-6,0,14"
                       Text="LEDVANCE, Tuya, SmartThings &amp; Matter are trademarks of their respective owners; this project is not affiliated with them." />

            <!-- Device list -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Devices" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.Devices" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Edit names, rooms and connection details, then press Apply. 'LAN first' uses the local network when an IP and local key are known." />
                    <DataGrid CanUserSortColumns="True" ItemsSource="{Binding DeviceConfigs}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="360" BorderBrush="{DynamicResource Border}"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Border}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="*" />
                            <DataGridTextColumn Header="IP address" Binding="{Binding Ip}" SortMemberPath="IpSortKey" Width="*" />
                            <DataGridComboBoxColumn Header="Version" SelectedItemBinding="{Binding Version}" SortMemberPath="Version" Width="80" x:Name="VersionColumn" />
                            <!-- Local keys are masked (fixed length, so not even the length leaks); the eye shows one row's key -->
                            <DataGridTemplateColumn Header="Local key" Width="1.4*" MinWidth="190" SortMemberPath="HasLocalKey">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock x:Name="None" Text="&#x2014;" Foreground="{DynamicResource TextMuted}" Visibility="Collapsed" Margin="4,0" />
                                            <!-- the whole cell is the button: click the dots (or the eye) to show / hide this key -->
                                            <ToggleButton x:Name="Reveal" Style="{StaticResource RevealCell}"
                                                          ToolTip="Click to show or hide this local key" AutomationProperties.Name="Show local key">
                                                <Grid>
                                                    <TextBlock Text="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;" FontFamily="Consolas"
                                                               Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                                    <TextBlock Text="{Binding LocalKey}" FontFamily="Consolas"
                                                               Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </ToggleButton>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding LocalKey}" Value="{x:Null}">
                                                <Setter TargetName="Reveal" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="None" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LocalKey}" Value="">
                                                <Setter TargetName="Reveal" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="None" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <!-- editing (double-click) is an explicit choice, so the key is shown while typing -->
                                    <DataTemplate>
                                        <TextBox Text="{Binding LocalKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="LAN first" Binding="{Binding PreferLocal}" Width="70" />
                            <DataGridCheckBoxColumn Header="Cloud" Binding="{Binding InCloud}" Width="55" IsReadOnly="True" />
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Apply changes" Style="{StaticResource AccentButton}" Command="{Binding SaveDevicesCommand}" />
                        <Button Content="Remove selected" Command="{Binding RemoveDeviceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Matter -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Matter over Wi-Fi (local, no hub)" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.Matter" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Controls Matter bulbs directly over your LAN — no hub and no cloud. This PC becomes an additional Matter controller, so the bulb keeps working in its current app too. Open a pairing window for the bulb in its current app (e.g. 'Share' / 'Linked Matter apps'), then enter the code shown there." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Pairing code (11 or 21 digits, or MT:… from the QR code)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding MatterCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Bulb IP (optional, speeds up pairing)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding MatterIp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Pair Matter device" Style="{StaticResource AccentButton}" Command="{Binding PairMatterCommand}" />
                        <Button Content="Find devices in pairing mode" Command="{Binding FindMatterCommand}" />
                        <Button Content="Refresh Matter devices" Command="{Binding SyncMatterCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Status: " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding MatterStatus, Mode=OneWay}" />
                    </TextBlock>
                    <DataGrid CanUserSortColumns="True" ItemsSource="{Binding MatterDiscovered}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" MaxHeight="160"
                              HeadersVisibility="Column" GridLinesVisibility="None" BorderBrush="{DynamicResource Border}">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MatterDiscovered.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DeviceName}" Width="2*" />
                            <DataGridTextColumn Header="Discriminator" Binding="{Binding Discriminator}" Width="100" />
                            <DataGridTextColumn Header="Vendor / product" Binding="{Binding VendorProduct}" Width="*" />
                            <DataGridTextColumn Header="Address" Binding="{Binding FirstAddress}" SortMemberPath="AddressSortKey" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- SmartThings -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="SmartThings (for cloud-locked bulbs)" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.SmartThings" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6">
                        For bulbs that only live in SmartThings. Create an OAuth app once with the SmartThings CLI
                        (smartthings apps:create → "OAuth-In App"), scopes r:devices:* x:devices:* w:devices:* r:locations:*.
                        SmartThings rejects http://localhost redirects, so use an HTTPS redirect that shows the returned code,
                        e.g. https://httpbin.org/get — set that same URL both in the app and in the Redirect URI box below.
                        Then: enter Client ID + Secret, click "Open sign-in page", approve, copy the "code" value from the page,
                        paste it below and click "Use code", then Sync. Control runs through the SmartThings cloud (needs internet).
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Client ID" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding StClientId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Client Secret" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="StSecretBox" PasswordChanged="StSecretBox_PasswordChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Redirect URI (must match the OAuth app)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding StRedirect, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open sign-in page" Style="{StaticResource AccentButton}" Command="{Binding OpenStSignInCommand}" />
                        <Button Content="Sync SmartThings devices" Command="{Binding SyncStCommand}" />
                        <TextBlock VerticalAlignment="Center" Margin="4,0,0,0">
                            <Run Text="Status: " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding StStatus, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="After approving, paste the redirected URL (or just the code value) here and click 'Use code':" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Use code" Style="{StaticResource AccentButton}" Command="{Binding ConnectStManualCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding StManualCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="(Advanced: if you registered an http://localhost redirect and SmartThings accepts it, 'Open sign-in page' will capture the code automatically.)" />
                </StackPanel>
            </Border>

            <!-- Cloud -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Tuya cloud project (optional)" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.Tuya" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6">
                        Create a free Cloud project at iot.tuya.com, link your app account under Devices → Link App Account,
                        and paste the project's Access ID / Access Secret here. Synchronising imports every device with its
                        local key, data points, rooms, scenes and automations. Afterwards devices are controlled over the LAN
                        whenever possible; the cloud is only used as fallback.
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Data centre" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Access ID / Client ID" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Access Secret / Client Secret" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="SecretBox" PasswordChanged="SecretBox_PasswordChanged" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Command="{Binding SaveCloudCommand}" />
                        <Button Content="Save &amp; synchronise devices" Style="{StaticResource AccentButton}" Command="{Binding SyncCommand}" />
                        <TextBlock Text="{Binding SyncProgress}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- LAN -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Local network" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.Lan" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Discovery listens to the UDP broadcasts devices send (ports 6666/6667/7000) and fills in IP addresses and protocol versions of known devices. Allow the app through the Windows firewall when asked." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Discover devices (10 s)" Style="{StaticResource AccentButton}" Command="{Binding DiscoverCommand}" />
                        <Button Content="Import tinytuya devices.json…" Command="{Binding ImportCommand}" />
                    </StackPanel>
                    <DataGrid CanUserSortColumns="True" ItemsSource="{Binding Discovered}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" MaxHeight="200"
                              HeadersVisibility="Column" GridLinesVisibility="None" BorderBrush="{DynamicResource Border}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device id" Binding="{Binding Id}" Width="2*" />
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" SortMemberPath="IpSortKey" Width="*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" />
                            <DataGridTextColumn Header="Product key" Binding="{Binding ProductKey}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Manual add -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Add a device manually" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.Manual" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid DataContext="{Binding NewDevice}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Name" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Name}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Device id" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Local key (16 chars)" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="NewKeyBox" PasswordChanged="NewKeyBox_PasswordChanged" FontFamily="Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="IP address" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Ip}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Text="Version" Style="{StaticResource Label}" />
                            <ComboBox x:Name="VersionCombo" SelectedItem="{Binding Version}" />
                        </StackPanel>
                        <StackPanel Grid.Column="5">
                            <TextBlock Text="Type" Style="{StaticResource Label}" ToolTip="dj = light, cz = plug, kg = switch" />
                            <ComboBox x:Name="CategoryCombo" SelectedItem="{Binding Category}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Add device" Style="{StaticResource AccentButton}" Command="{Binding AddManualCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Muted}" Margin="2,0,0,20">
                <Run Text="Configuration file (secrets protected by " /><Run Text="{Binding SecretProtection, Mode=OneWay}" /><Run Text=", folder readable by you only): " /><Run Text="{Binding ConfigPath, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>


