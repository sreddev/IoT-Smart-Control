<UserControl x:Class="LedvanceControl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LedvanceControl.App.Views">
    <!-- DataContext: SettingsViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
                <views:HelpButton Topic="Settings" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Appearance + Credits: compact two-column card (Option A) -->
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- App settings -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <TextBlock Text="App settings" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                            <views:HelpButton Topic="Settings.Appearance" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Theme -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <TextBlock Text="Theme" VerticalAlignment="Center" Width="104" />
                            <TextBlock Text="Light" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Text="Dark" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <!-- Start minimized -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <TextBlock Text="Start minimized" VerticalAlignment="Center" Width="104" />
                            <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding DataContext.StartMinimized, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Text="Launch at Windows start-up, in the tray" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <!-- Close to tray -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Close to tray" VerticalAlignment="Center" Width="104" />
                            <CheckBox Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding DataContext.CloseToTray, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Text="Closing keeps it running in the tray" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Border}" Margin="0,2" />

                    <!-- Credits -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                            <Run Text="Credits" FontWeight="SemiBold" /><Run Text="    " /><Run Text="Made with " Foreground="{DynamicResource TextMuted}" /><Run Text="&#x2665;" Foreground="{DynamicResource Accent}" /><Run Text=" by " Foreground="{DynamicResource TextMuted}" /><Run Text="Sergio" FontWeight="SemiBold" /><Run Text="   ·   License " Foreground="{DynamicResource TextMuted}" /><Run Text="MIT" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Hyperlink NavigateUri="https://github.com/sreddev" RequestNavigate="Link_RequestNavigate" Foreground="{DynamicResource Accent}" TextDecorations="None">GitHub @sreddev</Hyperlink><Run Text="    ·    " Foreground="{DynamicResource TextMuted}" /><Hyperlink NavigateUri="https://t.me/sreddev" RequestNavigate="Link_RequestNavigate" Foreground="{DynamicResource Accent}" TextDecorations="None">Telegram @sreddev</Hyperlink><Run Text="    ·    " Foreground="{DynamicResource TextMuted}" /><Hyperlink NavigateUri="https://www.paypal.com/paypalme/sreddev?locale.x=ro_RO&amp;country.x=RO" RequestNavigate="Link_RequestNavigate" Foreground="{DynamicResource Accent}" TextDecorations="None">Donate</Hyperlink>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                   Text="LEDVANCE, Tuya &amp; SmartThings are trademarks of their respective owners; this project is not affiliated with them." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Device list -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Devices" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.Devices" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Edit names, rooms and connection details, then press Apply. 'LAN first' uses the local network when an IP and local key are known." />
                    <DataGrid ItemsSource="{Binding DeviceConfigs}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="360" BorderBrush="{DynamicResource Border}"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Border}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="*" />
                            <DataGridTextColumn Header="IP address" Binding="{Binding Ip}" Width="*" />
                            <DataGridComboBoxColumn Header="Version" SelectedItemBinding="{Binding Version}" Width="70" x:Name="VersionColumn" />
                            <DataGridTextColumn Header="Local key" Binding="{Binding LocalKey}" Width="*" FontFamily="Consolas" />
                            <DataGridCheckBoxColumn Header="LAN first" Binding="{Binding PreferLocal}" Width="70" />
                            <DataGridCheckBoxColumn Header="Cloud" Binding="{Binding InCloud}" Width="55" IsReadOnly="True" />
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Apply changes" Style="{StaticResource AccentButton}" Command="{Binding SaveDevicesCommand}" />
                        <Button Content="Remove selected" Command="{Binding RemoveDeviceCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SmartThings -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="SmartThings (for cloud-locked bulbs)" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.SmartThings" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6">
                        For bulbs that only live in SmartThings. Create an OAuth app once with the SmartThings CLI
                        (smartthings apps:create → "OAuth-In App"), scopes r:devices:* x:devices:* w:devices:* r:locations:*.
                        SmartThings rejects http://localhost redirects, so use an HTTPS redirect that shows the returned code,
                        e.g. https://httpbin.org/get — set that same URL both in the app and in the Redirect URI box below.
                        Then: enter Client ID + Secret, click "Open sign-in page", approve, copy the "code" value from the page,
                        paste it below and click "Use code", then Sync. Control runs through the SmartThings cloud (needs internet).
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Client ID" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding StClientId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Client Secret" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="StSecretBox" PasswordChanged="StSecretBox_PasswordChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Redirect URI (must match the OAuth app)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding StRedirect, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open sign-in page" Style="{StaticResource AccentButton}" Command="{Binding OpenStSignInCommand}" />
                        <Button Content="Sync SmartThings devices" Command="{Binding SyncStCommand}" />
                        <TextBlock VerticalAlignment="Center" Margin="4,0,0,0">
                            <Run Text="Status: " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding StStatus, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="After approving, paste the redirected URL (or just the code value) here and click 'Use code':" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Use code" Style="{StaticResource AccentButton}" Command="{Binding ConnectStManualCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding StManualCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="(Advanced: if you registered an http://localhost redirect and SmartThings accepts it, 'Open sign-in page' will capture the code automatically.)" />
                </StackPanel>
            </Border>

            <!-- Cloud -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Tuya cloud project (optional)" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.Tuya" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6">
                        Create a free Cloud project at iot.tuya.com, link your app account under Devices → Link App Account,
                        and paste the project's Access ID / Access Secret here. Synchronising imports every device with its
                        local key, data points, rooms, scenes and automations. Afterwards devices are controlled over the LAN
                        whenever possible; the cloud is only used as fallback.
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Data centre" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Access ID / Client ID" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Access Secret / Client Secret" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="SecretBox" PasswordChanged="SecretBox_PasswordChanged" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Command="{Binding SaveCloudCommand}" />
                        <Button Content="Save &amp; synchronise devices" Style="{StaticResource AccentButton}" Command="{Binding SyncCommand}" />
                        <TextBlock Text="{Binding SyncProgress}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- LAN -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Local network" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.Lan" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Discovery listens to the UDP broadcasts devices send (ports 6666/6667/7000) and fills in IP addresses and protocol versions of known devices. Allow the app through the Windows firewall when asked." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Discover devices (10 s)" Style="{StaticResource AccentButton}" Command="{Binding DiscoverCommand}" />
                        <Button Content="Import tinytuya devices.json…" Command="{Binding ImportCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Discovered}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" MaxHeight="200"
                              HeadersVisibility="Column" GridLinesVisibility="None" BorderBrush="{DynamicResource Border}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device id" Binding="{Binding Id}" Width="2*" />
                            <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" />
                            <DataGridTextColumn Header="Product key" Binding="{Binding ProductKey}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Manual add -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Add a device manually" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        <views:HelpButton Topic="Settings.Manual" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid DataContext="{Binding NewDevice}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Name" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Name}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Device id" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Local key (16 chars)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding LocalKey}" FontFamily="Consolas" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="IP address" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Ip}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Text="Version" Style="{StaticResource Label}" />
                            <ComboBox x:Name="VersionCombo" SelectedItem="{Binding Version}" />
                        </StackPanel>
                        <StackPanel Grid.Column="5">
                            <TextBlock Text="Type" Style="{StaticResource Label}" ToolTip="dj = light, cz = plug, kg = switch" />
                            <ComboBox x:Name="CategoryCombo" SelectedItem="{Binding Category}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Add device" Style="{StaticResource AccentButton}" Command="{Binding AddManualCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Muted}" Margin="2,0,0,20">
                <Run Text="Configuration file (secrets encrypted with Windows DPAPI): " /><Run Text="{Binding ConfigPath, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>


