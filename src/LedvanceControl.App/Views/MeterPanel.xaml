<UserControl x:Class="LedvanceControl.App.Views.MeterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: EnergyViewModel -->
    <StackPanel>
        <DockPanel Margin="0,0,0,2">
            <TextBlock Text="Energy monitor" Style="{StaticResource H2}" DockPanel.Dock="Left" />
            <TextBlock Text="● Live" Foreground="{DynamicResource Ok}" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                   Text="Live readings from the plug's power meter. Read-only; refreshes with each poll." />

        <!-- Hero: current power draw -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
            <TextBlock Text="{Binding PowerText}" FontSize="58" FontWeight="Bold" Foreground="{DynamicResource TextMain}" />
            <TextBlock Text="W" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Bottom" Margin="6,0,0,10" />
        </StackPanel>
        <TextBlock Text="Current power draw" Style="{StaticResource Muted}" HorizontalAlignment="Center" />

        <!-- Live power bar -->
        <Border Height="8" CornerRadius="5" Background="{DynamicResource ControlBg}" Margin="2,16,2,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding FillStar}" />
                    <ColumnDefinition Width="{Binding RestStar}" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="5" Background="{DynamicResource Accent}" />
            </Grid>
        </Border>

        <!-- Stat tiles -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ControlBg}" CornerRadius="10" Padding="14,12" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Voltage" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding VoltageText}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="V" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Bottom" Margin="3,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource ControlBg}" CornerRadius="10" Padding="14,12" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Current" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding CurrentText}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="A" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Bottom" Margin="3,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource ControlBg}" CornerRadius="10" Padding="14,12" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Energy total" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding EnergyText}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="kWh" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Bottom" Margin="3,0,0,3" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
